# Path inside the container where the SQLite database is stored.
# The default is fine for most deployments - the volume handles persistence.
OLF_DB_PATH=/data/SlingStrike.db

# Browser hostname or IP, without a scheme, port, or path.
# Keep localhost for local use; set the Docker host's LAN IP or DNS name for remote access.
SLINGSTRIKE_HOST=localhost

# Optional custom TLS: set BOTH to literal multiline PEM contents in single quotes.
# Leave both empty to use Caddy's local CA. See the TLS guide for a full example.
# CERT_PEM must contain the server certificate followed by intermediate certificates.
# KEY_PEM must contain the matching unencrypted private key.
# Protect .env with chmod 600; these values are visible to Docker administrators.
SLINGSTRIKE_TLS_CERT_PEM=''
SLINGSTRIKE_TLS_KEY_PEM=''
