olf_version: "1.0"
id: "f47ac10b-58cc-4372-a567-000000000002"
name: "RDP Password Spray - Failed Logon"
description: "Simulates multiple RDP authentication failures across user accounts, consistent with a password spray attack. Generates Windows Security Event 4625 (failed logon, logon type 10 - remote interactive)."
tier: community
visibility: public_readonly
created_by: "SlingStrike Community"
created_at: "2026-06-27T00:00:00Z"
last_edited_at: "2026-06-27T00:00:00Z"
exported_at: "2026-06-27T00:00:00Z"
log_source:
  category: os
  platform: Windows
classification:
  mitre_tactics:
    - TA0006
  mitre_techniques:
    - T1110.003
  tags:
    - windows
    - rdp
    - password-spray
    - credential-access
log_events:
  - sequence: 1
    format: windows_evtxml
    template: |
      <Event xmlns="http://schemas.microsoft.com/win/2004/08/events/event">
        <System>
          <EventID>4625</EventID>
          <Computer>{{ computer_name }}</Computer>
          <TimeCreated SystemTime="{{ _ts_rfc3164 }}"/>
        </System>
        <EventData>
          <Data Name="TargetUserName">{{ target_username }}</Data>
          <Data Name="LogonType">10</Data>
          <Data Name="IpAddress">{{ src_ip }}</Data>
          <Data Name="WorkstationName">{{ workstation_name }}</Data>
          <Data Name="SubStatus">0xc000006a</Data>
        </EventData>
      </Event>
    repeat: 30
    delay_ms: 200
    variables:
      computer_name:
        type: hostname
        default: "dc01.corp.local"
      _ts_rfc3164:
        type: timestamp
        default: "2026-06-27T00:00:00Z"
        source: generated
      target_username:
        type: string
        default: "Administrator"
      src_ip:
        type: ip
        default: "10.10.0.1"
      workstation_name:
        type: hostname
        default: "ATTACKER-PC"
