%YAML 1.2
---
olf_version: '1.0'
id: 7afa089a-8ad4-4839-bb96-0f51942ba01f
name: 'SSH Endpoint Denial of Service: Service Exhaustion Flood'
tier: community
visibility: public_readonly
created_by: SlingStrike Community
created_at: '2026-07-15T17:12:32.000Z'
last_edited_at: '2026-07-20T20:32:07.707Z'
exported_at: '2026-07-20T20:32:44.667Z'
imported_at:
description: Simulates repeated SSH session exhaustion from multiple or single source IP. Generates syslog RFC 3164 messages as produced by OpenSSH on Linux targets.
classification:
  mitre_tactics:
    - TA0040
  mitre_techniques:
    - T1499
  tags:
    - linux
    - ssh
    - dos
    - exhaustion
log_events:
  - sequence: 1
    format: syslog_rfc3164
    template: |-
      # Hardcoded hostname, hardcoded username, hardcoded source IP address
      <34>{{ _ts_rfc3164 }} ws_hardcoded sshd-session[{{ _pid }}]: error: maximum authentication attempts exceeded for user_hardcoded from 1.1.1.1 port {{ _port_dynamic }} ssh2 [preauth]
    variables:
      _ts_rfc3164:
        type: timestamp
        source: generated
        format: rfc3164
        offset_seconds: 0
        default: Jun 27 00:00:00
      _pid:
        type: integer
        source: generated
        min: 1024
        max: 32768
        default: 1234
      _port_dynamic:
        type: integer
        source: generated
        min: 49152
        max: 65535
        default: 55000
    delay_ms: 5000
    repeat: 5
  - sequence: 2
    format: syslog_rfc3164
    template: |-
      # Hardcoded hostname, hardcoded username, random source IP address - CIDR 192.168.0.0/16
      <34>{{ _ts_rfc3164 }} ws_hardcoded sshd-session[{{ _pid }}]: error: maximum authentication attempts exceeded for user_hardcoded from {{ _src_ipv4 }} port {{ _port_dynamic }} ssh2 [preauth]
    variables:
      _ts_rfc3164:
        type: timestamp
        source: generated
        format: rfc3164
        offset_seconds: 0
        default: Jun 27 00:00:00
      _pid:
        type: integer
        source: generated
        min: 1024
        max: 32768
        default: 1234
      _src_ipv4:
        type: ipv4
        source: generated
        cidr: 192.168.0.0/16
        default: 192.168.1.100
      _port_dynamic:
        type: integer
        source: generated
        min: 49152
        max: 65535
        default: 55000
    delay_ms: 5000
    repeat: 5
  - sequence: 3
    format: syslog_rfc3164
    template: |-
      # Hardcoded hostname, predefined usernames, random source IP address - CIDR 192.168.0.0/16
      <34>{{ _ts_rfc3164 }} ws_hardcoded sshd-session[{{ _pid }}]: error: maximum authentication attempts exceeded for {{ username }} from {{ _src_ipv4 }} port {{ _port_dynamic }} ssh2 [preauth]
    variables:
      _ts_rfc3164:
        type: timestamp
        source: generated
        format: rfc3164
        offset_seconds: 0
        default: Jun 27 00:00:00
      _pid:
        type: integer
        source: generated
        min: 1024
        max: 32768
        default: 1234
      _src_ipv4:
        type: ipv4
        source: generated
        cidr: 192.168.0.0/16
        default: 192.168.1.100
      _port_dynamic:
        type: integer
        source: generated
        min: 49152
        max: 65535
        default: 55000
      username:
        type: enum
        source: generated
        default: jsmith
        values:
          - jsmith
          - mwilson
          - adavis
          - bjones
          - tsanders
    delay_ms: 5000
    repeat: 5
  - sequence: 4
    format: syslog_rfc3164
    template: |-
      # Predefined hostnames, predefined usernames, random source IP address - CIDR 192.168.0.0/16
      <34>{{ _ts_rfc3164 }} {{ hostname }} sshd-session[{{ _pid }}]: error: maximum authentication attempts exceeded for {{ username }} from {{ _src_ipv4 }} port {{ _port_dynamic }} ssh2 [preauth]
    variables:
      _ts_rfc3164:
        type: timestamp
        source: generated
        format: rfc3164
        offset_seconds: 0
        default: Jun 27 00:00:00
      _pid:
        type: integer
        source: generated
        min: 1024
        max: 32768
        default: 1234
      _src_ipv4:
        type: ipv4
        source: generated
        cidr: 192.168.0.0/16
        default: 192.168.1.100
      _port_dynamic:
        type: integer
        source: generated
        min: 49152
        max: 65535
        default: 55000
      username:
        type: enum
        source: generated
        default: jsmith
        values:
          - jsmith
          - mwilson
          - adavis
          - bjones
          - tsanders
      hostname:
        type: enum
        source: generated
        default: WS-ALPHA
        values:
          - WS-ALPHA
          - WS-BETA
          - DESKTOP-3F7K2
          - LAPTOP-SEC01
          - SRV-PROD01
    delay_ms: 5000
    repeat: 5
