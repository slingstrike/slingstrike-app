olf_version: "1.0"
id: "f47ac10b-58cc-4372-a567-00000000000c"
name: "Cloud Storage Exfiltration - S3 GetObject"
description: "Simulates AWS CloudTrail JSON log entries for bulk S3 GetObject events from an unexpected source IP, consistent with data exfiltration from cloud object storage."
tier: community
visibility: public_readonly
created_by: "SlingStrike Community"
created_at: "2026-06-27T00:00:00Z"
last_edited_at: "2026-06-27T00:00:00Z"
exported_at: "2026-06-27T00:00:00Z"
log_source:
  category: cloud
  platform: AWS S3
classification:
  mitre_tactics:
    - TA0010
  mitre_techniques:
    - T1530
  tags:
    - cloud
    - aws
    - s3
    - exfiltration
log_events:
  - sequence: 1
    format: json
    template: '{"eventTime":"{{ _ts_rfc3164 }}","eventName":"GetObject","eventSource":"s3.amazonaws.com","userIdentity":{"userName":"{{ iam_username }}"},"sourceIPAddress":"{{ src_ip }}","requestParameters":{"bucketName":"{{ bucket_name }}","key":"{{ object_key }}"},"additionalEventData":{"bytesTransferredOut":{{ bytes_transferred }}}}'
    repeat: 10
    delay_ms: 200
    variables:
      _ts_rfc3164:
        type: timestamp
        default: "2026-06-27T00:00:00Z"
        source: generated
      iam_username:
        type: string
        default: "svc-backup"
      src_ip:
        type: ip
        default: "198.51.100.1"
      bucket_name:
        type: string
        default: "corp-sensitive-data"
      object_key:
        type: string
        default: "exports/payroll-2026.csv"
      bytes_transferred:
        type: integer
        default: 5242880
        min: 1
        max: 104857600
        source: generated
