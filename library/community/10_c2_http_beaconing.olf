olf_version: "1.0"
id: "f47ac10b-58cc-4372-a567-00000000000a"
name: "C2 HTTP Beaconing - Periodic Outbound Connection"
description: "Simulates firewall LEEF log entries for periodic outbound HTTP/S connections consistent with command-and-control beaconing. Generates Palo Alto PAN-OS TRAFFIC log format."
tier: community
visibility: public_readonly
created_by: "openLogForge Community"
created_at: "2026-06-27T00:00:00Z"
last_edited_at: "2026-06-27T00:00:00Z"
exported_at: "2026-06-27T00:00:00Z"
log_source:
  category: security_device
  platform: Palo Alto PAN-OS
classification:
  mitre_tactics:
    - TA0011
  mitre_techniques:
    - T1071.001
  tags:
    - firewall
    - beaconing
    - command-and-control
    - network
log_events:
  - sequence: 1
    format: leef
    template: "LEEF:2.0|Palo Alto Networks|PAN-OS|10.1|TRAFFIC\tdevTime={{ _ts_rfc3164 }}\tsrc={{ src_ip }}\tdst={{ dst_ip }}\tdstPort={{ dst_port }}\tproto=6\ttotalBytes={{ bytes_out }}\tcat=allow"
    repeat: 5
    delay_ms: 60000
    variables:
      _ts_rfc3164:
        type: timestamp
        default: "2026-06-27T00:00:00Z"
        source: generated
      src_ip:
        type: ip
        default: "10.10.0.50"
      dst_ip:
        type: ip
        default: "203.0.113.1"
      dst_port:
        type: integer
        default: 443
        min: 1
        max: 65535
      bytes_out:
        type: integer
        default: 1024
        min: 64
        max: 65535
        source: generated
