olf_version: "1.0"
id: "f47ac10b-58cc-4372-a567-000000000004"
name: "Kerberoasting - TGS Request with RC4"
description: "Simulates Kerberos service ticket requests using RC4 encryption (0x17), the primary indicator of Kerberoasting. Generates Windows Security Event 4769."
tier: community
visibility: public_readonly
created_by: "SlingStrike Community"
created_at: "2026-06-27T00:00:00Z"
last_edited_at: "2026-06-27T00:00:00Z"
exported_at: "2026-06-27T00:00:00Z"
log_source:
  category: os
  platform: Windows
classification:
  mitre_tactics:
    - TA0006
  mitre_techniques:
    - T1558.003
  tags:
    - windows
    - kerberos
    - kerberoasting
    - credential-access
log_events:
  - sequence: 1
    format: windows_evtxml
    template: |
      <Event xmlns="http://schemas.microsoft.com/win/2004/08/events/event">
        <System>
          <EventID>4769</EventID>
          <Computer>{{ computer_name }}</Computer>
          <TimeCreated SystemTime="{{ _ts_rfc3164 }}"/>
        </System>
        <EventData>
          <Data Name="TargetUserName">{{ requesting_user }}</Data>
          <Data Name="ServiceName">{{ service_name }}</Data>
          <Data Name="IpAddress">::ffff:{{ src_ip }}</Data>
          <Data Name="TicketEncryptionType">0x17</Data>
          <Data Name="TicketOptions">0x40810000</Data>
        </EventData>
      </Event>
    repeat: 5
    delay_ms: 1000
    variables:
      computer_name:
        type: hostname
        default: "dc01.corp.local"
      _ts_rfc3164:
        type: timestamp
        default: "2026-06-27T00:00:00Z"
        source: generated
      requesting_user:
        type: string
        default: "jdoe@CORP.LOCAL"
      service_name:
        type: string
        default: "MSSQLSvc/sqlserver01.corp.local:1433"
      src_ip:
        type: ip
        default: "10.10.0.50"
